# Copy to .env.local and fill in. .gitignore already covers .env*, so .env.local
# is never committed — this file is the checked-in record of what is needed.
# All seven must also be set in Vercel → Settings → Environment Variables.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Settings → API Keys → anon / publishable (newer projects: sb_publishable_…).
# Shipped to the browser on purpose. RLS is the security boundary, not this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Settings → API Keys → service_role / secret (newer projects: sb_secret_…).
# BYPASSES ALL RLS. Server-only — never prefix with NEXT_PUBLIC_.
# Read by exactly one file: src/lib/supabase/admin.ts
SUPABASE_SERVICE_ROLE_KEY=

# ─── Resend ──────────────────────────────────────────────────────────────────
# resend.com → API Keys → Create API Key (permission: Sending access)
RESEND_API_KEY=

# Must stay onboarding@resend.dev until a domain is verified in Resend.
ENQUIRY_FROM_EMAIL="Your Travels Enquiries <onboarding@resend.dev>"

# Comma-separated. On the test sender above, Resend will ONLY deliver to the
# address that owns the Resend account.
ADMIN_NOTIFY_EMAILS=

# ─── App ─────────────────────────────────────────────────────────────────────
# Builds the absolute "Open in admin" link inside the notification email.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
